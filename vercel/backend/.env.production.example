# =============================================================================
# SignPro Backend - Vercel Production Environment
# =============================================================================
# Set these in your Vercel project: Settings -> Environment Variables
# (or use scripts/set-env.sh to bulk-import this file)

NODE_ENV=production
PORT=4000

# --- URLs (must match your deployed domains) ---
API_BASE_URL=https://api.signpro.example.com
FRONTEND_URL=https://app.signpro.example.com

# --- Database (Neon, Vercel Postgres, or Supabase) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
PG_SSL=true

# --- Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM
SIGNATURE_HMAC_SECRET=REPLACE_WITH_THIRD_64_CHAR_RANDOM
BCRYPT_ROUNDS=12

# --- Vercel Blob (uploads) ---
VERCEL_BLOB_ENABLED=true
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxx
UPLOAD_DIR=/tmp/signpro-uploads
MAX_FILE_SIZE_MB=25

# --- SMTP (your provider) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key
SMTP_FROM_NAME=SignPro
SMTP_FROM_ADDRESS=no-reply@signpro.example.com

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# --- Browser extension ---
EXTENSION_POLL_SECRET=REPLACE_WITH_32_CHAR_RANDOM
EXTENSION_ID=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# --- Logging ---
LOG_LEVEL=info
