# Server Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://signpro:signpro_password@localhost:5432/signpro
PGHOST=localhost
PGPORT=5432
PGDATABASE=signpro
PGUSER=signpro
PGPASSWORD=signpro_password
PG_SSL=false

# JWT / Security
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars_long
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=replace_with_another_long_random_secret_at_least_64_chars
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SIGNATURE_HMAC_SECRET=replace_with_signature_specific_secret_min_32_chars

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Default SMTP Configuration (overridable per user)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM_NAME=SignPro
SMTP_FROM_ADDRESS=no-reply@signpro.example.com

# Twilio (SMS) Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_MESSAGING_SERVICE_SID=

# Browser Extension
EXTENSION_POLL_SECRET=replace_with_extension_polling_secret
EXTENSION_ID=your_chrome_extension_id_for_origin_validation

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Logging
LOG_LEVEL=info
